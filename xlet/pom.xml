<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.ralfspoeth.xldr</groupId>
        <artifactId>xldr</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>xlet</artifactId>

    <properties>
        <!--
            EE11 is the Jakarta release that carries Servlet 6.1, which is the API
            this module compiles against - hence the ee11 artifacts and a 12.1 line.
            Pairing 6.1 with Jetty's ee10 modules would not resolve.
        -->
        <jetty.version>12.1.12</jetty.version>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <configuration>
                    <skipPublishing>true</skipPublishing>
                </configuration>
            </plugin>
            <!--
                The parent only manages failsafe; a module runs its integration
                tests by saying so, as `it` does. Without this the *IT classes
                match no surefire pattern and no failsafe execution, and are
                quietly not run at all.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <!-- nullness -->
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>
        <!-- the servlet, supplied by the container at runtime. Not managed by
             the parent, this module being the only one that has an opinion -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>6.1.0</version>
            <scope>provided</scope>
        </dependency>
        <!-- xldr -->
        <dependency>
            <groupId>io.github.ralfspoeth.xldr</groupId>
            <artifactId>ia</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.ralfspoeth.xldr</groupId>
            <artifactId>ldr</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- one test loads for real, which needs a database and an adapter to
             read with; the refusals need neither -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.ralfspoeth.xldr</groupId>
            <artifactId>csv</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!--
            An embedded container for the integration test. Jetty rather than
            Tomcat: it is built to be embedded, and ServletContextHandler takes a
            resource base directly - which is what lets the test exercise the real
            /WEB-INF/specs/ lookup rather than a fake of it.
        -->
        <dependency>
            <groupId>org.eclipse.jetty.ee11</groupId>
            <artifactId>jetty-ee11-servlet</artifactId>
            <version>${jetty.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
