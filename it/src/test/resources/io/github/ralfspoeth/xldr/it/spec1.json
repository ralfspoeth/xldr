{
  "input": {
    "mimeType": "text/xml",
    "recordSelectors": [
      {
        "name": "fund",
        "selector": "/root/fund",
        "fieldSelectors": [
          { "name": "id",   "selector": "@id",                   "type": "TEXT" },
          { "name": "desc", "selector": "normalize-space(text())", "type": "TEXT" }
        ]
      }
    ]
  },
  "mapping": [
    {
      "recordSelector": "fund",
      "table": "fund",
      "fieldMapping": [
        { "fieldSelector": "id",   "column": "id_txt" },
        { "fieldSelector": "desc", "column": "desc_txt" },
        { "constant": "PD",        "column": "source_cd" }
      ]
    }
  ]
}
