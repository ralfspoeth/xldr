#!/bin/sh
# xldr server launcher.
#
# The server reads xldr.properties from the working directory, or from the one
# named by --dir:
#   cd /var/lib/xldr && /opt/xldr/bin/xldr
#   /opt/xldr/bin/xldr --dir /var/lib/xldr
#
# lib/ holds the application and the toolkit - what has to be there. The other
# three hold what a deployment chooses: modules/ the input adapters, xl/ the
# Excel adapter with the Apache POI libraries it needs, drivers/ the JDBC
# drivers. All four go on the module path, and JPMS service binding resolves the
# adapters (uses/provides InputAdapterFactory) and the driver (java.sql uses
# Driver) from there, so no --add-modules is needed. Add and remove by moving
# jars: your own driver into drivers/, a format out of modules/, xl/ deleted
# whole if you read no spreadsheets.
#
# java is taken from JAVA_HOME when that is set, and from PATH otherwise.
# JAVA_OPTS may carry extra VM options, e.g.
#   JAVA_OPTS=-Xmx512m bin/xldr
set -eu

fail() {
    echo "xldr: $1" >&2
    exit 1
}

# The installation, resolved through any symlinks the script was invoked
# through - /usr/local/bin/xldr pointing into /opt/xldr is an ordinary way to
# install this, and dirname alone would then find the wrong directory.
self=$0
while [ -L "$self" ]; do
    link=$(readlink "$self")
    case $link in
        /*) self=$link ;;
        *) self=$(dirname "$self")/$link ;;
    esac
done
here=$(cd "$(dirname "$self")/.." && pwd) || fail "cannot determine the installation directory"

[ -d "$here/lib" ] || fail "no lib/ in $here - is the distribution complete?"

if [ -n "${JAVA_HOME:-}" ]; then
    java=$JAVA_HOME/bin/java
    [ -x "$java" ] || fail "JAVA_HOME is set to $JAVA_HOME, but $java is not executable"
else
    java=$(command -v java) || fail "no java on PATH and JAVA_HOME is not set"
fi

# A wrong JVM otherwise fails with an UnsupportedClassVersionError naming a
# class file version, which says nothing to whoever has to fix it. An
# unparseable answer is not held against the JVM: the run is what tells.
required=25
version=$("$java" -XshowSettings:properties -version 2>&1 |
    sed -n 's/^ *java\.specification\.version = \([0-9][0-9]*\).*/\1/p') || version=
if [ -n "$version" ] && [ "$version" -lt "$required" ]; then
    fail "Java $required or later is required, but $java is $version"
fi

# modules/, xl/ and drivers/ may each be absent, or empty, and all of that is
# fine: they hold what a deployment chooses - the formats it reads, whether it
# reads spreadsheets, the database it talks to - and choosing none of something
# is a choice. Only lib/ has to be there, which is checked above. A server with
# no adapters starts and refuses to activate any feed, which is loud in the right
# place.
modulepath=$here/lib
[ -d "$here/modules" ] && modulepath=$modulepath:$here/modules
[ -d "$here/xl" ] && modulepath=$modulepath:$here/xl
[ -d "$here/drivers" ] && modulepath=$modulepath:$here/drivers

exec "$java" ${JAVA_OPTS:-} -Dxldr.home="$here" -p "$modulepath" \
    -m io.github.ralfspoeth.xldr.app/io.github.ralfspoeth.xldr.app.App "$@"
