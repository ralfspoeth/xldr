<?xml version='1.0'?>
<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.2.0 http://maven.apache.org/xsd/assembly-2.2.0.xsd">
    <id>dist</id>
    <formats>
        <format>tar.gz</format>
        <format>zip</format>
    </formats>
    <baseDirectory>xldr-${project.version}</baseDirectory>

    <!--
        Four directories on the module path, and the division is between what has
        to be there and what a deployment chooses.

        lib/ is the first: the application, the toolkit and what they need at run
        time. Remove anything from it and nothing starts. The other three hold
        service providers, one directory per kind of choice - which formats
        (modules/), whether Excel (xl/), which database (drivers/) - and each is
        found by JPMS service binding rather than by any code naming it, so
        adding and removing them is a matter of moving jars.
    -->
    <dependencySets>
        <!-- the application jar plus everything it needs at run time -->
        <dependencySet>
            <outputDirectory>lib</outputDirectory>
            <useProjectArtifact>true</useProjectArtifact>
            <scope>runtime</scope>
        </dependencySet>
        <!--
            The input adapters, so that a deployment can drop the formats it does
            not read.

            Named one by one rather than selected by scope, because `provided`
            here does not mean what it looks like: the assembly plugin's scope
            filter is inclusive downward, so `provided` selects compile *and*
            provided and would take ia, spec, xmls and Greyson json along with
            the adapters. That was always true - both sets used to write to lib/,
            where a jar copied twice to one path is a jar - and only became
            visible when the directories parted.

            The list is also the invariant: what belongs here is an adapter that
            needs nothing but the toolkit already in lib/. One that brings a
            library of its own gets a directory of its own, as xlsx does, so that
            deleting the format deletes the library with it. That is why no
            transitive filtering is wanted here - there is nothing to follow.
        -->
        <dependencySet>
            <outputDirectory>modules</outputDirectory>
            <useProjectArtifact>false</useProjectArtifact>
            <scope>provided</scope>
            <includes>
                <include>io.github.ralfspoeth.xldr:csv</include>
                <include>io.github.ralfspoeth.xldr:flt</include>
                <include>io.github.ralfspoeth.xldr:json</include>
                <include>io.github.ralfspoeth.xldr:xml</include>
            </includes>
        </dependencySet>
        <!-- Excel, in a directory of its own, because it is most of the
             distribution by weight: POI brings xmlbeans, curvesapi, four commons
             libraries and log4j-api, and lib/ was largely them. Separating it
             makes what the toolkit is made of legible again.

             Named for the format rather than for the library that reads it, as
             drivers/ is: what a deployment decides is whether it loads
             spreadsheets, and Apache POI is how that happens to be done.

             The adapter goes with them rather than staying in lib/, which is
             what makes the directory droppable rather than merely separate. A
             deployment reading no spreadsheets deletes xl/ and the server
             starts; leaving xlsx behind, its `requires` unsatisfiable, would
             stop the JVM before main - service binding resolves a provider's
             own dependencies, and a missing one is a FindException, not a
             quietly absent format. -->
        <dependencySet>
            <outputDirectory>xl</outputDirectory>
            <useProjectArtifact>false</useProjectArtifact>
            <scope>provided</scope>
            <useTransitiveFiltering>true</useTransitiveFiltering>
            <includes>
                <include>io.github.ralfspoeth.xldr:xlsx</include>
            </includes>
        </dependencySet>
        <!-- the JDBC drivers, in a directory of their own: which database a
             deployment feeds is its own business, so this is where it adds the
             driver it needs and removes the ones it does not. The launcher puts
             the directory on the module path beside lib/, where java.sql finds
             a Driver by service binding as it does any other provider.

             Two, and both freely redistributable. A driver that is not - the
             Oracle one, which this shipped until 0.40 - makes the project a
             redistributor of somebody else's licence, and there is nothing here
             that needs it: a driver is found by service binding, so installing
             one is copying a jar into this directory. src/dist/drivers/README.txt
             says so, and is copied in beside them. -->
        <dependencySet>
            <outputDirectory>drivers</outputDirectory>
            <useProjectArtifact>false</useProjectArtifact>
            <scope>provided</scope>
            <includes>
                <include>org.postgresql:postgresql</include>
                <include>com.h2database:h2</include>
            </includes>
        </dependencySet>
    </dependencySets>

    <fileSets>
        <fileSet>
            <directory>${project.basedir}/src/dist/bin</directory>
            <outputDirectory>bin</outputDirectory>
            <fileMode>0755</fileMode>
        </fileSet>
        <fileSet>
            <directory>${project.basedir}/src/dist/conf</directory>
            <outputDirectory>conf</outputDirectory>
            <fileMode>0644</fileMode>
        </fileSet>
        <fileSet>
            <directory>${project.basedir}/src/dist/drivers</directory>
            <outputDirectory>drivers</outputDirectory>
            <fileMode>0644</fileMode>
        </fileSet>
    </fileSets>

    <files>
        <file>
            <source>${project.basedir}/../README.md</source>
            <outputDirectory>.</outputDirectory>
            <fileMode>0644</fileMode>
        </file>
    </files>
</assembly>
